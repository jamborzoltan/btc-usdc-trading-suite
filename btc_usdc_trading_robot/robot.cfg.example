[robot]
mode = live_read_only
poll_seconds = 1

[web_state]
url = https://sajatdomain.hu/api/state.php
runtime_url = https://sajatdomain.hu/api/robot-runtime.php
# A webapp „Robotok” paneljén az adott felhasználóhoz létrehozott, egyedi token.
runtime_token = IDE_LEGALABB_24_KARAKTERES_KULON_TITOK_KELL
username =
password =

[binance_usdm]
# Csak a mini PC-n lévő robot.cfg fájlba kerüljön valódi kulcs. A webtárhelyre ne töltsd fel.
# Az első ellenőrzéshez az API-kulcson csak USD-M Futures olvasási jogosultság legyen.
api_key = IDE_JON_A_BINANCE_API_KEY
api_secret = IDE_JON_A_BINANCE_API_SECRET
base_url = https://fapi.binance.com
symbol = BTCUSDC
recv_window_ms = 5000

[live_trading]
# Biztonságos első indításhoz maradjon false és a [robot] mode live_read_only.
# Éles módhoz mindkettőt át kell állítani, a pontos acknowledgement mondattal együtt.
enabled = false
acknowledgement =
max_order_notional_usdc = 0
max_daily_loss_usdc = 0
max_position_loss_percent = 50
state_file = execution_state.json
